{
  "name": "robo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"pnpm --filter @robo/server dev\" \"pnpm --filter @robo/client dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "assets:machines": "node tools/generate-machine-assets.mjs",
    "assets:machines:check": "node tools/generate-machine-assets.mjs --check",
    "notes": "node tools/build-notes.mjs",
    "notes:check": "node tools/build-notes.mjs --check",
    "engine:build": "cd engine && wasm-pack build crates/wasm --release --target web --out-dir ../../../packages/engine/wasm && node ../tools/engine-tidy.mjs",
    "engine:test": "cd engine && cargo test && cd .. && pnpm --filter @robo/shared exec vitest run test/rust-parity.test.ts && pnpm --filter @robo/client exec vitest run test/rust-water.test.ts",
    "engine:bench": "node tools/engine-bench.mjs",
    "engine:check": "node tools/engine-tidy.mjs --check",
    "app:android": "node tools/android-build.mjs debug",
    "app:android:release": "node tools/android-build.mjs release",
    "engine:catalog": "pnpm --filter @robo/server exec tsx ../../tools/engine-catalog.mjs",
    "engine:protocol": "pnpm --filter @robo/server exec tsx ../../tools/engine-protocol.mjs",
    "engine:furniture": "node apps/server/node_modules/tsx/dist/cli.mjs tools/engine-furniture.mjs",
    "engine:pets": "node apps/server/node_modules/tsx/dist/cli.mjs tools/engine-pets.mjs",
    "engine:tiles": "node tools/engine-tiles.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.27.0",
    "marked": "^15.0.12",
    "puppeteer-core": "^25.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.0"
  }
}
